# Free key at https://aistudio.google.com/apikey - same one you use for the web assistant.
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional - lets the coding agent look things up (docs, error messages) instead
# of guessing. Free at https://app.tavily.com. Leave unset to run without it.
TAVILY_API_KEY=your_tavily_api_key_here

# How to spawn the MCP servers. Defaults assume this app sits alongside
# apps/mcp-filesystem and apps/mcp-web-search in the same monorepo (dev setup).
# Override these if you package/distribute the app separately.
MCP_FILESYSTEM_SERVER_COMMAND=npx
MCP_FILESYSTEM_SERVER_ARGS=tsx ../mcp-filesystem/src/server.ts
MCP_WEB_SEARCH_SERVER_COMMAND=npx
MCP_WEB_SEARCH_SERVER_ARGS=tsx ../mcp-web-search/src/server.ts