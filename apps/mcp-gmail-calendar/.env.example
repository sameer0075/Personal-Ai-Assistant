# This server reads its own .env regardless of who spawns it or what the
# working directory is (see config/env.ts) - it must be filled in independently
# of apps/backend/.env, even though several values below have to MATCH the
# backend's values exactly (see comments).

# Same Postgres database the backend uses - this is how the two processes
# share the one Google credentials row without talking to each other directly.
DATABASE_URL=postgres://assistant:assistant_dev_password@localhost:5432/ai_assistant

# MUST be byte-for-byte identical to apps/backend/.env's GOOGLE_TOKEN_ENCRYPTION_KEY,
# or this server won't be able to decrypt the refresh token the backend stored.
GOOGLE_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# Same Google OAuth client used by the backend's consent flow.
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here