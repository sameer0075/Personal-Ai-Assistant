# This server reads its own .env regardless of who spawns it or what the
# working directory is (see config/env.ts), same as apps/mcp-gmail-calendar.

DATABASE_URL=postgres://assistant:assistant_dev_password@localhost:5432/ai_assistant

# MUST be byte-for-byte identical to apps/backend/.env's LINKEDIN_TOKEN_ENCRYPTION_KEY.
LINKEDIN_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# Same LinkedIn Developer App used by the backend's consent flow.
LINKEDIN_OAUTH_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_OAUTH_CLIENT_SECRET=your_linkedin_client_secret_here

# Must match apps/backend's LINKEDIN_API_VERSION.
LINKEDIN_API_VERSION=202607