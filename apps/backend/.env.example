# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://assistant:assistant_dev_password@localhost:5432/ai_assistant

# --- LLM (Google Gemini) ---
# Get a free key at https://aistudio.google.com/apikey
# Uses the free rate-limited tier by default -> near-zero cost.
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Embeddings ---
# Runs 100% locally via @xenova/transformers (transformers.js) - no API key, no cost.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- RAG chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=5

# --- Google OAuth (Gmail + Calendar) ---
# Create these at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application", redirect URI must match GOOGLE_OAUTH_REDIRECT_URI below)
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/google/callback

# 32-byte key, hex-encoded, used to encrypt the stored Google refresh token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST exactly match apps/mcp-gmail-calendar/.env's GOOGLE_TOKEN_ENCRYPTION_KEY.
GOOGLE_TOKEN_ENCRYPTION_KEY=generate_a_64_char_hex_key
# --- LinkedIn OAuth (posting) ---
# Create a LinkedIn app at https://www.linkedin.com/developers/apps, then request
# the "Sign In with LinkedIn using OpenID Connect" AND "Share on LinkedIn" products.
LINKEDIN_OAUTH_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_OAUTH_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:4000/api/linkedin/callback

# Independent key from Google's - can reuse the same 64-char hex value or generate
# a fresh one. MUST exactly match apps/mcp-linkedin/.env's LINKEDIN_TOKEN_ENCRYPTION_KEY.
LINKEDIN_TOKEN_ENCRYPTION_KEY=generate_a_64_char_hex_key

# LinkedIn versions its API by month (YYYYMM). Check for a newer version occasionally:
# https://learn.microsoft.com/en-us/linkedin/marketing/versioning
LINKEDIN_API_VERSION=202506
FRONTEND_BASE_URL=http://localhost:3000

# --- MCP servers (one entry per external service the agent can act on) ---
# How the backend spawns each MCP server as a child process over stdio.
MCP_GMAIL_CALENDAR_SERVER_COMMAND=npx
MCP_GMAIL_CALENDAR_SERVER_ARGS=tsx ../mcp-gmail-calendar/src/server.ts
MCP_LINKEDIN_SERVER_COMMAND=npx
MCP_LINKEDIN_SERVER_ARGS=tsx ../mcp-linkedin/src/server.ts
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
