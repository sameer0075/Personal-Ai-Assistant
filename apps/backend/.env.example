# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://assistant:assistant_dev_password@localhost:5432/ai_assistant

# --- LLM (Google Gemini) ---
# Get a free key at https://aistudio.google.com/apikey
# Uses the free rate-limited tier by default -> near-zero cost.
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Embeddings ---
# Runs 100% locally via @xenova/transformers (transformers.js) - no API key, no cost.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- RAG chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=5

# --- Google OAuth (Gmail + Calendar) ---
# Create these at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application", redirect URI must match GOOGLE_OAUTH_REDIRECT_URI below)
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/google/callback

# 32-byte key, hex-encoded, used to encrypt the stored Google refresh token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST exactly match apps/mcp-gmail-calendar/.env's GOOGLE_TOKEN_ENCRYPTION_KEY.
GOOGLE_TOKEN_ENCRYPTION_KEY=generate_a_64_char_hex_key
FRONTEND_BASE_URL=http://localhost:3000

# --- MCP server (Gmail/Calendar tool provider) ---
# How the backend spawns apps/mcp-gmail-calendar as a child process over stdio.
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=tsx ../mcp-gmail-calendar/src/server.ts
