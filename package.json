{
  "name": "ai-assistant-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/mcp-gmail-calendar",
    "apps/mcp-linkedin",
    "apps/mcp-web-search",
    "apps/mcp-filesystem",
    "apps/desktop"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "npm run migrate --workspace=apps/backend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:mcp": "npm run dev --workspace=apps/mcp-gmail-calendar"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "react-file-icon": "^1.6.0"
  },
  "devDependencies": {
    "@types/react-file-icon": "^1.0.5"
  }
}
