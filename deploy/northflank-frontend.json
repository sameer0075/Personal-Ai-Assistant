{
  "name": "frontend",
  "description": "Next.js frontend for the AI assistant",
  "deployment": {
    "external": {
      "imagePath": "registry.northflank.com/sameer0075s/ai-assistant-frontend:latest",
      "registryCredentialId": null
    }
  },
  "ports": [
    {
      "name": "frontend-http",
      "internalPort": 3000,
      "public": true,
      "domains": [],
      "protocol": "HTTP"
    }
  ],
  "runtimeEnvironment": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "scale": {
    "instances": 1,
    "deploymentPlan": "nf-compute-20"
  }
}
